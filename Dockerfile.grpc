# Lightweight Dockerfile for gRPC mode - NLP models served by separate service
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install only API dependencies - NO ML packages
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    "uvicorn[standard]==0.24.0.post1" \
    "pydantic>=2.6.0,<2.10.0" \
    pydantic-settings \
    elasticsearch==8.19.0 \
    httpx==0.27.2 \
    python-multipart==0.0.12 \
    prometheus-fastapi-instrumentator==6.1.0 \
    boto3 \
    anthropic \
    openai \
    grpcio>=1.60.0 \
    protobuf>=5.26.0 \
    numpy \
    Levenshtein==0.26.1 \
    openpyxl \
    regex \
    PyMuPDF==1.24.5 \
    beautifulsoup4

# Copy application code
COPY revisto_evidence_aligned/ ./revisto_evidence_aligned/
COPY main.py ./

# Create non-root user
RUN useradd -m -u 1000 appuser \
 && mkdir -p /home/appuser/.aws \
 && chown -R appuser:appuser /app /home/appuser

USER appuser

# Runtime environment
ENV PYTHONPATH=/app \
    HOME=/home/appuser \
    NLP_MODE=grpc

EXPOSE 8888

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8888", "--workers", "2"]
