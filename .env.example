# Elasticsearch Configuration
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASS=
ES_INDEX=revisto_evidence
ES_ALIAS=revisto_evidence
ES_VERIFY_CERTS=false

# Embedding Model
EMBED_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb

# NER Configuration
NER_MODEL=d4data/biomedical-ner-all
NER_ENABLED=true

# Scoring Weights
W_SEMANTIC=3
W_LEXICAL=3
W_NUMERIC=1
W_ENTITY=1

# Claude Configuration (for evidence filtering)
CLAUDE_FILTER_ENABLED=true
CLAUDE_MODEL=claude-opus-4-20250514

# API Keys (alternatively use AWS Secrets Manager)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key
# LANDINGAI_API_KEY=your_landingai_api_key

# AWS Configuration (for cloud deployment)
AWS_DEFAULT_REGION=us-east-1
